@model MedicalPortal.Models.DoctorsFilterViewModel
@using MedicalPortal.Services
@{
    ViewData["Title"] = "Врачи";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h2 class="fw-bold mb-0">Врачи медицинского портала</h2>
        <p class="text-muted mb-0">У каждого врача есть аккаунт, специальность и свой профильный диагноз</p>
    </div>
    <a asp-controller="Account" asp-action="RegisterDoctor" class="btn btn-primary">+ Создать врача и аккаунт</a>
</div>

<form method="get" class="filter-panel mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-semibold">Специальность</label>
            <select name="specialization" class="form-select">
                <option value="">Все специальности</option>
                @foreach (var spec in DoctorFactory.Specializations)
                {
                    <option value="@spec.Label" selected="@(Model.Specialization == spec.Label)">@spec.Label</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold">Диагноз врача</label>
            <select name="diagnosis" class="form-select">
                <option value="">Любой диагноз</option>
                @foreach (var diag in Model.AvailableDiagnoses)
                {
                    <option value="@diag" selected="@(Model.Diagnosis == diag)">@diag</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold">Мин. стаж (лет)</label>
            <input type="number" name="minExperience" value="@Model.MinExperience" min="0" max="70" class="form-control" placeholder="Напр. 5" />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold">Поиск</label>
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Имя или диагноз" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Фильтровать</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Сброс</a>
        </div>
    </div>
</form>

@if (!Model.Doctors.Any())
{
    <div class="alert alert-info">По заданным фильтрам врачи не найдены.</div>
}
else
{
    <div class="row g-3">
        @foreach (var doctor in Model.Doctors)
        {
            <div class="col-md-6 col-lg-4">
                <div class="portal-card p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="spec-badge @DoctorFactory.GetBadgeCssClass(doctor.Specialization)">@doctor.Specialization</span>
                            <span class="text-muted small">Стаж: <strong>@doctor.Experience</strong> лет</span>
                        </div>
                        <h5 class="fw-bold mb-2">@doctor.Name</h5>
                        <p class="small text-muted mb-2">
                            Логин аккаунта: <code>@doctor.Login</code>
                        </p>
                        <div class="mb-2">
                            <span class="small text-muted">Ставит диагноз:</span><br />
                            <span class="diagnosis-pill mt-1">@doctor.DefaultDiagnosis</span>
                        </div>
                        <div class="p-2 bg-light rounded border small mt-3">
                            <span class="text-muted">Приём (<code>Reception()</code>):</span><br />
                            @doctor.Reception()
                        </div>
                    </div>
                    <div class="mt-3 pt-2 border-top d-flex gap-2">
                        <a asp-controller="Appointments" asp-action="Create" asp-route-doctorId="@doctor.Id" class="btn btn-sm btn-outline-primary flex-grow-1">
                            Записаться
                        </a>
                        <form asp-action="Delete" asp-route-id="@doctor.Id" method="post" onsubmit="return confirm('Удалить врача @doctor.Name и все его записи?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
