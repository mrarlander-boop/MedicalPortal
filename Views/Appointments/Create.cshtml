@model MedicalPortal.Models.CreateAppointmentViewModel
@{
    ViewData["Title"] = "Новая запись на приём";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="portal-card p-4">
            <h3 class="fw-bold mb-3">Запись на приём к врачу</h3>
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="DoctorId" class="form-label fw-semibold"></label>
                    <select asp-for="DoctorId" class="form-select">
                        <option value="">-- Выберите врача --</option>
                        @foreach (var doc in Model.Doctors)
                        {
                            <option value="@doc.Id">
                                @doc.Name — @doc.Specialization (стаж @doc.Experience лет, диагноз: @doc.DefaultDiagnosis)
                            </option>
                        }
                    </select>
                    <span asp-validation-for="DoctorId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AppointmentDate" class="form-label fw-semibold"></label>
                    <input asp-for="AppointmentDate" type="datetime-local"
                           value="@Model.AppointmentDate.ToString("yyyy-MM-ddTHH:mm")"
                           class="form-control" />
                    <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                </div>

                <hr class="my-4" />

                <div class="mb-3">
                    <label class="form-label fw-semibold d-block">Режим выбора пациента</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="PatientMode" id="modeExisting" value="existing"
                               checked="@(Model.PatientMode != "new")" onchange="togglePatientMode()" />
                        <label class="btn btn-outline-primary" for="modeExisting">Выбрать из базы</label>

                        <input type="radio" class="btn-check" name="PatientMode" id="modeNew" value="new"
                               checked="@(Model.PatientMode == "new")" onchange="togglePatientMode()" />
                        <label class="btn btn-outline-primary" for="modeNew">Новый пациент</label>
                    </div>
                </div>

                <div id="existingPatientBlock" class="mb-3">
                    <label asp-for="PatientId" class="form-label fw-semibold">Пациент</label>
                    <select asp-for="PatientId" class="form-select">
                        <option value="">-- Выбрать из базы --</option>
                        @foreach (var p in Model.Patients)
                        {
                            <option value="@p.Id">@p.Name (@p.Age лет, диагноз: @p.Diagnosis)</option>
                        }
                    </select>
                    <span asp-validation-for="PatientId" class="text-danger small"></span>
                </div>

                <div id="newPatientBlock" class="p-3 bg-light rounded border mb-3" style="display: none;">
                    <div class="fw-semibold mb-2">Регистрация нового пациента:</div>
                    <div class="row g-2">
                        <div class="col-md-8">
                            <label asp-for="NewPatientName" class="form-label small"></label>
                            <input asp-for="NewPatientName" class="form-control" placeholder="ФИО нового пациента" />
                            <span asp-validation-for="NewPatientName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NewPatientAge" class="form-label small"></label>
                            <input asp-for="NewPatientAge" type="number" class="form-control" min="0" max="130" placeholder="Возраст" />
                            <span asp-validation-for="NewPatientAge" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Записать на приём</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePatientMode() {
            const isNew = document.getElementById('modeNew').checked;
            document.getElementById('existingPatientBlock').style.display = isNew ? 'none' : 'block';
            document.getElementById('newPatientBlock').style.display = isNew ? 'block' : 'none';
        }
        document.addEventListener('DOMContentLoaded', togglePatientMode);
    </script>
}
